# Hermes Agent Environment Configuration

# API Key (required)
# Use either OpenAI or Anthropic API key
OPENAI_API_KEY=your_api_key_here
# ANTHROPIC_API_KEY=your_api_key_here

# Base URL (optional)
# The agent will auto-construct the /chat/completions endpoint
# Default for OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model Selection (optional)
# Default: gpt-4o
MODEL=gpt-4o
# MODEL_ID=gpt-4o

# Context Configuration
# Maximum context rounds to keep in memory (default: 40)
# One round = one user question + one assistant answer
MAX_CONTEXT_ROUNDS=40

# Conversation History File
# All conversations are saved in JSONL format
CONVERSATION_FILE=conversations.jsonl

# Debug Mode
# Set to true for detailed logging (request/response details, errors)
# Useful for troubleshooting API issues
DEBUG=false

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log to file: true or false
LOG_FILE=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# User Settings
DEFAULT_USER_ID=default
MAX_HISTORY_ROUNDS=40
