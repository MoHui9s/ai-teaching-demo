# =============================================================================
# Tan同学-AI英语助教 配置文件模板
# 复制此文件为 .env 并填入你的配置
# =============================================================================
# Chat LLM + Embedding + ASR 统一使用阿里云百炼 DashScope API
# 获取 API Key：https://bailian.console.aliyun.com/ → 模型广场 → API Key 管理
# 新人免费额度：每个模型 100 万 Tokens（90 天有效）
# =============================================================================

# --- 百炼 DashScope 配置 ---
ADMIN_TOKEN=your_admin_token_here
OPENAI_API_KEY=sk-your-bailian-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
ASR_MODEL=qwen3-asr-flash

# --- 日志配置 ---
LOG_LEVEL=INFO
DEV_MODE=true

# --- 默认开发账号（DEV_MODE=true 时生效）---
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=password123

# --- JWT 配置 ---
JWT_SECRET=change-this-to-a-random-secret-in-production

# --- Agent 配置 ---
MAX_CONTEXT_ROUNDS=40
MAX_TOOL_ITERATIONS=8

# --- 成本控制 ---
# 每日 API 预算上限（元），0 表示不限制
DAILY_API_BUDGET=2.0

# --- RAG 配置 ---
CHROMA_PERSIST_DIR=./data/chroma_db
