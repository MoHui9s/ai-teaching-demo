FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖（LevelDB 需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libleveldb-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY pyproject.toml ./

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] pydantic \
    requests python-dotenv edge-tts \
    bcrypt pyjwt plyvel sqlalchemy \
    chromadb openai apscheduler \
    azure-cognitiveservices-speech

# 复制应用代码
COPY . .

# 创建数据目录
RUN mkdir -p /app/data /app/memories /app/logs

# 暴露端口
EXPOSE 8000

# 启动服务
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
