# =============================================================================
# Tan同学-AI英语助教 配置文件
# =============================================================================

# --- LLM 配置 ---
ADMIN_TOKEN=tan_admin_2026
OPENAI_API_KEY=Y_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# --- 日志配置 ---
LOG_LEVEL=INFO
DEV_MODE=true

# --- 默认开发账号 ---
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=password123

# --- JWT 配置 ---
JWT_SECRET=tan-english-tutor-secret-key-change-in-production

# --- Agent 配置 ---
MAX_CONTEXT_ROUNDS=40
MAX_TOOL_ITERATIONS=8

# --- Azure 语音服务（发音评估）---
# 免费层额度：每月 5 小时音频
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# --- Azure TTS（可选，Edge TTS 作为免费备份）---
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastasia

# --- 成本控制 ---
# 每日 API 预算上限（元），0 表示不限制
DAILY_API_BUDGET=2.0
# 发音评估每月预算（元）
MONTHLY_SPEECH_BUDGET=60.0

# --- RAG 配置 ---
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=text-embedding-3-small
# 如果使用本地 embedding，设置以下路径
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
